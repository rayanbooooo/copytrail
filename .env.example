# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Alpaca Broker API (brokerage / clearing / custody / KYC) ---
# sandbox|live — switches which base URL below is used
ALPACA_ENV=sandbox
ALPACA_BROKER_API_KEY_ID=
ALPACA_BROKER_API_SECRET=
ALPACA_BROKER_BASE_URL_SANDBOX=https://broker-api.sandbox.alpaca.markets
ALPACA_BROKER_BASE_URL_LIVE=https://broker-api.alpaca.markets
# Market Data API uses a SEPARATE credential set from the Broker API
ALPACA_MARKET_DATA_API_KEY_ID=
ALPACA_MARKET_DATA_API_SECRET=
# Shared secret used to verify incoming Alpaca webhook signatures
ALPACA_WEBHOOK_SECRET=

# --- Plaid (bank linking -> Alpaca ACH funding) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox|development|production
PLAID_ENV=sandbox

# --- Stripe ($15/mo copy-trading subscription billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_COPY_SUBSCRIPTION=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Cron ---
# Shared secret required in the Authorization header of cron-triggered requests
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
